        {
          "id": "q06",
          "answerable": true,
          "refused": false,
          "answer": "According to EIOPA's 2025 Opinion, the AI Act identifies as high-risk the use of AI systems for risk assessment and pricing in relation to natural persons in the case of life and health insurance [eiopa_ai_opinion_2025, p. 3].",
          "citations": [
            [
              "eiopa_ai_opinion_2025",
              3
            ]
